local TweenService     = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui", 10)
if not PlayerGui then return end

if PlayerGui:FindFirstChild("Anxiee_Aiming") then
    PlayerGui:FindFirstChild("Anxiee_Aiming").Enabled = not PlayerGui:FindFirstChild("Anxiee_Aiming").Enabled
    return
end

-- ================================================================
-- STATE
-- ================================================================
local State = {
    Aimbot          = false,
    Smoothness      = false,
    FOVCircle       = false,
    SizeFOV         = false,
    TeamCheck       = false,
    VisibilityCheck = false,
}

-- ================================================================
-- IMGUI TOKENS
-- ================================================================
local C = {
    WinBg       = Color3.fromRGB(28, 28, 28),
    TitleBg     = Color3.fromRGB(41, 74, 122),
    TitleBgText = Color3.fromRGB(255, 255, 255),
    Border      = Color3.fromRGB(90, 90, 90),
    FrameBg     = Color3.fromRGB(41, 41, 41),
    FrameBgHov  = Color3.fromRGB(55, 55, 55),
    CheckMark   = Color3.fromRGB(79, 144, 220),
    Text        = Color3.fromRGB(255, 255, 255),
    TextDim     = Color3.fromRGB(160, 160, 160),
    SepLine     = Color3.fromRGB(70, 70, 70),
    Header      = Color3.fromRGB(160, 160, 160),
    Accent      = Color3.fromRGB(79, 144, 220),
}

local FONT      = Enum.Font.Code
local IsMobile  = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local WIN_W     = IsMobile and 220 or 260
