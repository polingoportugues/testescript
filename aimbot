local function MakeSlider(parent, key, labelText, minVal, maxVal, defaultVal, yPos)
    local FrameH = ROW_H + 12
    local Row = Instance.new("Frame")
    Row.Name                 = "Slider_" .. key
    Row.Size                 = UDim2.new(1, -PAD_X * 2, 0, FrameH)
    Row.Position             = UDim2.new(0, PAD_X, 0, yPos)
    Row.BackgroundTransparency = 1
    Row.ZIndex               = 202
    Row.Parent               = parent

    local Lbl = Instance.new("TextLabel")
    Lbl.Size               = UDim2.new(1, 0, 0, FONT_SIZE + 2)
    Lbl.Position           = UDim2.new(0, 0, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text               = labelText .. ": " .. tostring(defaultVal)
    Lbl.TextColor3         = C.TextDim
    Lbl.Font               = FONT
    Lbl.TextSize           = FONT_SIZE - 1
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left
    Lbl.ZIndex             = 203
    Lbl.Parent             = Row

    local Track = Instance.new("Frame")
    Track.Size             = UDim2.new(1, 0, 0, 10)
    Track.Position         = UDim2.new(0, 0, 0, FONT_SIZE + 4)
    Track.BackgroundColor3 = C.FrameBg
    Track.BorderSizePixel  = 0
    Track.ZIndex           = 203
    Track.Parent           = Row
    Stroke(Track, C.Border, 1)

    local Fill = Instance.new("Frame")
    local initRatio = (defaultVal - minVal) / (maxVal - minVal)
    Fill.Size             = UDim2.new(math.clamp(initRatio, 0, 1), 0, 1, 0)
    Fill.BackgroundColor3 = C.Accent
    Fill.BorderSizePixel  = 0
    Fill.ZIndex           = 204
    Fill.Parent           = Track

    local sliding = false
    local function UpdateInput(input)
        local posX = math.clamp(
            (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X,
            0, 1
        )
        local val = math.floor(minVal + (maxVal - minVal) * posX)
        State[key] = val
        Fill.Size = UDim2.new(posX, 0, 1, 0)
        Lbl.Text = labelText .. ": " .. tostring(val)
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            UpdateInput(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (
            input.UserInputType == Enum.UserInputType.MouseMovement or
            input.UserInputType == Enum.UserInputType.Touch
        ) then
            UpdateInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    return FrameH
end

