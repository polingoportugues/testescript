        NoneBtn.TextSize = FONT_SIZE - 1
        NoneBtn.TextXAlignment = Enum.TextXAlignment.Left
        NoneBtn.ZIndex = 251
        NoneBtn.Parent = ListFrame
        count = count + 1

        NoneBtn.Activated:Connect(function()
            State.TargetSelection = "Nenhum"
            BoxBtn.Text = "  Nenhum  ▼"
            expanded = false
            ListFrame.Visible = false
            ListFrame.Size = UDim2.new(1, 0, 0, 0)
        end)

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                count = count + 1
                local PBtn = Instance.new("TextButton")
                PBtn.Size = UDim2.new(1, 0, 0, ROW_H)
                PBtn.BackgroundColor3 = C.FrameBg
                PBtn.Text = "  " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
                PBtn.TextColor3 = C.Text
                PBtn.Font = FONT
                PBtn.TextSize = FONT_SIZE - 1
                PBtn.TextXAlignment = Enum.TextXAlignment.Left
                PBtn.ZIndex = 251
                PBtn.Parent = ListFrame

                PBtn.Activated:Connect(function()
                    State.TargetSelection = plr.Name
                    BoxBtn.Text = "  " .. plr.Name .. "  ▼"
                    expanded = false
                    ListFrame.Visible = false
                    ListFrame.Size = UDim2.new(1, 0, 0, 0)
                end)
            end
        end

        ListFrame.CanvasSize = UDim2.new(0, 0, 0, count * ROW_H)
        local displayH = math.min(count * ROW_H, 100)
        ListFrame.Size = UDim2.new(1, 0, 0, displayH)
    end

    BoxBtn.Activated:Connect(function()
        expanded = not expanded
        if expanded then
            RefreshPlayers()
            ListFrame.Visible = true
        else
            ListFrame.Visible = false
            ListFrame.Size = UDim2.new(1, 0, 0, 0)
        end
    end)

    return DropH
