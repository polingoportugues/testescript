local function GetMyViewModel()
    local viewModelsFolder = Workspace:FindFirstChild("ViewModels") and Workspace.ViewModels:FindFirstChild("FirstPerson")
    if not viewModelsFolder then return nil end

    for _, model in ipairs(viewModelsFolder:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            return model
        end
    end
    return nil
end

-- ================================================================
-- AIMBOT ENGINE & MULTI-LAYER TEAM CHECK
-- ================================================================

local function GetCharacter(player)
    return player and player.Character
end

local function GetHitbox(character)
    if not character then return nil end
    return character:FindFirstChild("HitboxHead")
        or character:FindFirstChild("PhysicalHitboxHead")
        or character:FindFirstChild("HitboxHeadSmall")
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(character)
    local hum = GetHumanoid(character)
    return hum and hum.Health > 0
end

-- SISTEMA ROBUSTO DE VERIFICAÇÃO DE TIME (ATRIBUTOS, QUEUE PADS & ROBLOX TEAMS)
local function GetCustomTeam(player)
    if not player then return nil end

    -- 1. Verificação via Atributos
    local attrTeam = player:GetAttribute("TeamID") or player:GetAttribute("Team") or player:GetAttribute("TeamName")
    if attrTeam ~= nil then
        return attrTeam
    end

    if player.Character then
        local charAttrTeam = player.Character:GetAttribute("TeamID") or player.Character:GetAttribute("Team")
        if charAttrTeam ~= nil then
            return charAttrTeam
        end
    end

    -- 2. Verificação via Workspace (Queue Pads)
    local important = Workspace:FindFirstChild("Important")
    if important then
        for _, obj in ipairs(important:GetDescendants()) do
            if obj:IsA("ObjectValue") or obj:IsA("StringValue") then
                if obj.Value == player or obj.Value == player.Name or obj.Value == player.Character then
                    local teamModel = obj:FindFirstAncestorOfClass("Model") or obj.Parent
                    if teamModel then
                        return teamModel.Name
                    end
                end
            end
        end
    end

    return nil
end

local function IsSameTeam(player)
    if not player or player == LocalPlayer then return true end

    -- 1. Tenta por Atributos / Queue Pads
    local myCustomTeam = GetCustomTeam(LocalPlayer)
    local targetCustomTeam = GetCustomTeam(player)

    if myCustomTeam ~= nil and targetCustomTeam ~= nil then
        return myCustomTeam == targetCustomTeam
    end

    -- 2. Fallback para sistema padrão do Roblox
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end

    if LocalPlayer.TeamColor and player.TeamColor and LocalPlayer.Team ~= nil then
        return LocalPlayer.TeamColor == player.TeamColor
    end

    return false
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function IsVisible(targetPart, char)
    local origin = Camera.CFrame.Position
    local localChar = GetCharacter(LocalPlayer)

    if not localChar then return false end

    rayParams.FilterDescendantsInstances = {localChar, Camera, Workspace:FindFirstChild("ViewModels")}
    local result = Workspace:Raycast(origin, targetPart.Position - origin, rayParams)
    
    if not result then return true end
    if result.Instance and (result.Instance:IsDescendantOf(char) or result.Instance:IsDescendantOf(targetPart.Parent)) then
        return true
    end

    return false
end

local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function WorldToScreen(pos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function GetDistanceFromCenter(target)
    local hitbox = GetHitbox(GetCharacter(target))
    if not hitbox then return math.huge end
    local screenPos, onScreen = WorldToScreen(hitbox.Position)
    if not onScreen then return math.huge end
    return (screenPos - GetScreenCenter()).Magnitude
end

local function IsInFOV(target)
    return GetDistanceFromCenter(target) <= State.FOVSizeValue
end

local function GetClosestTarget()
    -- Alvo Fixo
    if State.TargetSelection ~= "Nenhum" then
        local fixed = Players:FindFirstChild(State.TargetSelection)
        if fixed and fixed ~= LocalPlayer then
            local char = GetCharacter(fixed)
            if char and IsAlive(char) then
                if not State.TeamCheck or not IsSameTeam(fixed) then
                    local hitbox = GetHitbox(char)
                    if hitbox then
                        if not State.VisibilityCheck or IsVisible(hitbox, char) then
                            return fixed
                        end
                    end
                end
            end
        end
        return nil
    end

    -- Alvo Automático
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            -- Se TeamCheck estiver ativado e for do mesmo time, ignora o alvo
            if State.TeamCheck and IsSameTeam(plr) then 
                continue 
            end

            local char = GetCharacter(plr)
            if not char or not IsAlive(char) then continue end

            local hitbox = GetHitbox(char)
            if not hitbox then continue end

            if State.VisibilityCheck and not IsVisible(hitbox, char) then continue end
            if not IsInFOV(plr) then continue end

            local dist = GetDistanceFromCenter(plr)
            if dist < bestDist then
                bestDist = dist
                best = plr
            end
        end
    end
    return best
end

local function GetSmoothFactor()
    local t = (State.SmoothnessValue - 1) / 19
    return 0.05 + t * 0.55
end

-- ================================================================
-- AIMBOT ENGINE (RENDER PRIORITY CAMERA SYNCHRONIZED)
-- ================================================================

local function StartAimbot()
    RunService:UnbindFromRenderStep("AnxieeAimbotUpdate")
    RunService:BindToRenderStep("AnxieeAimbotUpdate", Enum.RenderPriority.Camera.Value + 1, function()
        if not State.Aimbot then return end

        local aiming = IsMobile or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if not aiming then return end

        local target = GetClosestTarget()
        if not target then return end

        local char = GetCharacter(target)
        local hitbox = GetHitbox(char)
        if not hitbox then return end

        local aimPos = hitbox.Position
        local smooth = GetSmoothFactor()

        -- 1. Trava da Câmera
        local currentCF = Camera.CFrame
        local targetCF  = CFrame.new(currentCF.Position, aimPos)
        local newCameraCF = currentCF:Lerp(targetCF, 1 - smooth)
        Camera.CFrame   = newCameraCF

        -- 2. Sincronização do ViewModel
        local vm = GetMyViewModel()
        if vm then
            local vmHRP = vm:FindFirstChild("HumanoidRootPart") or vm:FindFirstChild("FakeCamera") or vm:FindFirstChild("Root")
            if vmHRP then
                vmHRP.CFrame = newCameraCF
            else
                vm:PivotTo(newCameraCF)
            end
        end

        -- 3. Sincronização do Corpo
        local myChar = GetCharacter(LocalPlayer)
        if myChar and IsAlive(myChar) then
            local root = myChar:FindFirstChild("HumanoidRootPart")
            if root then
                local rootLookPos = Vector3.new(aimPos.X, root.Position.Y, aimPos.Z)
                root.CFrame = root.CFrame:Lerp(CFrame.new(root.Position, rootLookPos), 1 - smooth)
            end
        end
    end)
end

local function StopAimbot()
    RunService:UnbindFromRenderStep("AnxieeAimbotUpdate")
end

