        local NoneBtn = Instance.new("TextButton")
        NoneBtn.Size = UDim2.new(1, 0, 0, ROW_H)
        NoneBtn.BackgroundColor3 = C.FrameBg
        NoneBtn.Text = "  [Nenhum / Automático]"
