    if active then
        StartAimbot()
    else
        StopAimbot()
    end
end)

cursor = cursor + MakeSlider(Win, "SmoothnessValue", "Smoothness", 1, 20, State.SmoothnessValue, cursor)

cursor = cursor + MakeSectionHeader(Win, "FOV", cursor)
cursor = cursor + MakeCheckbox(Win, "FOVCircle", "FOV Circle", cursor, function()
    UpdateFOVCircle()
end)
cursor = cursor + MakeSlider(Win, "FOVSizeValue", "Size FOV", 30, 300, State.FOVSizeValue, cursor)

cursor = cursor + MakeSectionHeader(Win, "Targeting", cursor)
cursor = cursor + MakeDropdown(Win, "Target Selection", cursor)

cursor = cursor + MakeSectionHeader(Win, "Filters", cursor)
cursor = cursor + MakeCheckbox(Win, "TeamCheck", "Team Check", cursor)
cursor = cursor + MakeCheckbox(Win, "VisibilityCheck", "Visibility Check", cursor)

cursor = cursor + PAD_Y
Win.Size = UDim2.new(0, WIN_W, 0, cursor + 6)

-- ================================================================
-- DRAGGING LOGIC
-- ================================================================
local dragging, dragStart, winStartPos = false, nil, nil

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        winStartPos = Win.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        Win.Position = UDim2.new(
            winStartPos.X.Scale, winStartPos.X.Offset + d.X,
            winStartPos.Y.Scale, winStartPos.Y.Offset + d.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
