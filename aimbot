-- ================================================================
-- CHECKBOX BUILDER (ImGui style)
-- ================================================================
local function MakeCheckbox(parent, key, labelText, yPos)
    local Row = Instance.new("Frame")
    Row.Name                 = "Row_" .. key
    Row.Size                 = UDim2.new(1, -PAD_X * 2, 0, ROW_H)
    Row.Position             = UDim2.new(0, PAD_X, 0, yPos)
    Row.BackgroundTransparency = 1
    Row.ZIndex               = 202
    Row.Parent               = parent

    -- Square frame background (ImGui: FrameBg color, no radius)
    local Box = Instance.new("Frame")
    Box.Size             = UDim2.new(0, CHECK_S, 0, CHECK_S)
    Box.Position         = UDim2.new(0, 0, 0.5, -CHECK_S/2)
    Box.BackgroundColor3 = C.FrameBg
    Box.BorderSizePixel  = 0
    Box.ZIndex           = 203
    Box.Parent           = Row
    Stroke(Box, C.Border, 1)

    -- Checkmark (ImGui uses a drawn checkmark, we use text)
    local Tick = Instance.new("TextLabel")
    Tick.Size               = UDim2.new(1, 0, 1, 0)
    Tick.BackgroundTransparency = 1
    Tick.Text               = "✓"
    Tick.TextColor3         = C.CheckMark
    Tick.Font               = FONT
    Tick.TextSize           = CHECK_S - 1
    Tick.TextXAlignment     = Enum.TextXAlignment.Center
    Tick.TextYAlignment     = Enum.TextYAlignment.Center
    Tick.TextTransparency   = 1
    Tick.ZIndex             = 204
    Tick.Parent             = Box

    local Lbl = Instance.new("TextLabel")
    Lbl.Size               = UDim2.new(1, -(CHECK_S + 6), 1, 0)
    Lbl.Position           = UDim2.new(0, CHECK_S + 6, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text               = labelText
    Lbl.TextColor3         = C.Text
    Lbl.Font               = FONT
    Lbl.TextSize           = FONT_SIZE
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left
    Lbl.TextYAlignment     = Enum.TextYAlignment.Center
    Lbl.ZIndex             = 203
    Lbl.Parent             = Row

    local Btn = Instance.new("TextButton")
    Btn.Size               = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text               = ""
    Btn.AutoButtonColor    = false
    Btn.ZIndex             = 210
    Btn.Parent             = Row

    local function SetVisual(active)
        TweenService:Create(Box, TWEEN_F, {
            BackgroundColor3 = active and C.CheckMark or C.FrameBg,
        }):Play()
        TweenService:Create(Tick, TWEEN_F, {
            TextTransparency = active and 0 or 1,
            TextColor3       = active and Color3.fromRGB(255,255,255) or C.CheckMark,
        }):Play()
    end

    local function Toggle()
        State[key] = not State[key]
        SetVisual(State[key])
    end

    Btn.MouseButton1Click:Connect(Toggle)
    Btn.TouchTap:Connect(Toggle)
    Btn.MouseEnter:Connect(function()
        TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = State[key] and C.CheckMark or C.FrameBgHov }):Play()
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = State[key] and C.CheckMark or C.FrameBg }):Play()
    end)

    SetVisual(State[key])
end

-- ================================================================
-- SECTION SEPARATOR (ImGui separator + label)
-- ================================================================
local function MakeSectionHeader(parent, text, yPos)
    local Sep = Instance.new("Frame")
    Sep.Size             = UDim2.new(1, -PAD_X*2, 0, 1)
    Sep.Position         = UDim2.new(0, PAD_X, 0, yPos + 6)
    Sep.BackgroundColor3 = C.SepLine
    Sep.BorderSizePixel  = 0
    Sep.ZIndex           = 202
    Sep.Parent           = parent

    local Lbl = Instance.new("TextLabel")
    Lbl.Size               = UDim2.new(1, -PAD_X*2, 0, IsMobile and 16 or 18)
    Lbl.Position           = UDim2.new(0, PAD_X, 0, yPos + 8)
    Lbl.BackgroundTransparency = 1
    Lbl.Text               = text
    Lbl.TextColor3         = C.Header
    Lbl.Font               = FONT
    Lbl.TextSize           = IsMobile and 10 or 11
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left
    Lbl.ZIndex             = 202
    Lbl.Parent             = parent

    return (IsMobile and 16 or 18) + 10
end

-- ================================================================
-- LAYOUT
-- ================================================================
local SECTIONS = {
    { label = nil, items = {
        { key = "Aimbot",     label = "Aimbot"     },
        { key = "Smoothness", label = "Smoothness"  },
    }},
    { label = "FOV", items = {
        { key = "FOVCircle", label = "FOV Circle" },
        { key = "SizeFOV",   label = "Size FOV"   },
    }},
    { label = "Filters", items = {
        { key = "TeamCheck",       label = "Team Check"       },
        { key = "VisibilityCheck", label = "Visibility Check" },
    }},
}

local ContentY = TitleH + 4
local cursor   = ContentY

for _, section in ipairs(SECTIONS) do
    if section.label then
        cursor = cursor + MakeSectionHeader(Win, section.label, cursor)
    end
    for _, item in ipairs(section.items) do
        MakeCheckbox(Win, item.key, item.label, cursor)
        cursor = cursor + ROW_H
    end
    cursor = cursor + PAD_Y
end

Win.Size = UDim2.new(0, WIN_W, 0, cursor + 6)

-- ================================================================
-- DRAG — PC
-- ================================================================
local dragging, dragStart, winStartPos = false, nil, nil
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true ; dragStart = input.Position ; winStartPos = Win.Position
    end
end)
TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local d = input.Position - dragStart
        Win.Position = UDim2.new(winStartPos.X.Scale, winStartPos.X.Offset + d.X,
                                  winStartPos.Y.Scale, winStartPos.Y.Offset + d.Y)
    end
end)

-- ================================================================
-- DRAG — MOBILE
-- ================================================================
local touchOrigin, touchWinPos = nil, nil
TitleBar.TouchPan:Connect(function(tp, _, _, state)
    if state == Enum.UserInputState.Begin then
        touchOrigin = tp[1] ; touchWinPos = Win.Position
    elseif state == Enum.UserInputState.Change and touchWinPos then
        local d = tp[1] - touchOrigin
        Win.Position = UDim2.new(touchWinPos.X.Scale, touchWinPos.X.Offset + d.X,
                                  touchWinPos.Y.Scale, touchWinPos.Y.Offset + d.Y)
    elseif state == Enum.UserInputState.End then
        touchOrigin, touchWinPos = nil, nil
    end
end)
