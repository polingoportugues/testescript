-- Criador de Checkbox
local function MakeCheckbox(parent, key, labelText, yPos)
    local Row = Instance.new("Frame")
    Row.Name = "Row_"..key ; Row.Size = UDim2.new(1,-PAD_X*2,0,ROW_H)
    Row.Position = UDim2.new(0,PAD_X,0,yPos) ; Row.BackgroundTransparency = 1
    Row.ZIndex = 202 ; Row.Parent = parent

    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(0,CHECK_S,0,CHECK_S) ; Box.Position = UDim2.new(0,0,0.5,-CHECK_S/2)
    Box.BackgroundColor3 = C.FrameBg ; Box.BorderSizePixel = 0
    Box.ZIndex = 203 ; Box.Parent = Row
    Stroke(Box, C.Border, 1)

    local Tick = Instance.new("TextLabel")
    Tick.Size = UDim2.new(1,0,1,0) ; Tick.BackgroundTransparency = 1
    Tick.Text = "✓" ; Tick.TextColor3 = Color3.fromRGB(255,255,255)
    Tick.Font = FONT ; Tick.TextSize = CHECK_S - 1
    Tick.TextXAlignment = Enum.TextXAlignment.Center ; Tick.TextYAlignment = Enum.TextYAlignment.Center
    Tick.TextTransparency = 1 ; Tick.ZIndex = 204 ; Tick.Parent = Box

    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1,-(CHECK_S+6),1,0) ; Lbl.Position = UDim2.new(0,CHECK_S+6,0,0)
    Lbl.BackgroundTransparency = 1 ; Lbl.Text = labelText
    Lbl.TextColor3 = C.Text ; Lbl.Font = FONT ; Lbl.TextSize = FONT_SIZE
    Lbl.TextXAlignment = Enum.TextXAlignment.Left ; Lbl.TextYAlignment = Enum.TextYAlignment.Center
    Lbl.ZIndex = 203 ; Lbl.Parent = Row

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,1,0) ; Btn.BackgroundTransparency = 1
    Btn.Text = "" ; Btn.AutoButtonColor = false ; Btn.ZIndex = 210 ; Btn.Parent = Row

    local function SetVisual(active)
        TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = active and C.CheckMark or C.FrameBg }):Play()
        TweenService:Create(Tick, TWEEN_F, { TextTransparency = active and 0 or 1 }):Play()
    end

    local function Toggle() 
        State[key] = not State[key] 
        SetVisual(State[key])
    end

    Btn.MouseButton1Click:Connect(Toggle)
    Btn.MouseEnter:Connect(function() TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = State[key] and C.CheckMark or C.FrameBgHov }):Play() end)
    Btn.MouseLeave:Connect(function() TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = State[key] and C.CheckMark or C.FrameBg }):Play() end)
    SetVisual(State[key])
end

-- Criador de Slider ImGui estilo ImGui
local function MakeSlider(parent, labelText, minVal, maxVal, defaultVal, yPos, callback)
    local Row = Instance.new("Frame")
    Row.Name = "SliderRow_"..labelText ; Row.Size = UDim2.new(1,-PAD_X*2,0,ROW_H + 12)
    Row.Position = UDim2.new(0,PAD_X,0,yPos) ; Row.BackgroundTransparency = 1
    Row.ZIndex = 202 ; Row.Parent = parent

    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1,0,0,12) ; Lbl.Position = UDim2.new(0,0,0,0)
    Lbl.BackgroundTransparency = 1 ; Lbl.Text = labelText .. ": " .. tostring(defaultVal)
    Lbl.TextColor3 = C.Text ; Lbl.Font = FONT ; Lbl.TextSize = FONT_SIZE - 1
    Lbl.TextXAlignment = Enum.TextXAlignment.Left ; Lbl.ZIndex = 203 ; Lbl.Parent = Row

    local SliderBg = Instance.new("Frame")
    SliderBg.Size = UDim2.new(1,0,0,10) ; SliderBg.Position = UDim2.new(0,0,0,16)
    SliderBg.BackgroundColor3 = C.FrameBg ; SliderBg.BorderSizePixel = 0
    SliderBg.ZIndex = 203 ; SliderBg.Parent = Row
    Stroke(SliderBg, C.Border, 1)

    local Fill = Instance.new("Frame")
    local pct = (defaultVal - minVal) / (maxVal - minVal)
    Fill.Size = UDim2.new(pct,0,1,0) ; Fill.BackgroundColor3 = C.SliderFill
    Fill.BorderSizePixel = 0 ; Fill.ZIndex = 204 ; Fill.Parent = SliderBg

    local isDragging = false
    local function UpdateInput(input)
        local posX = math.clamp(input.Position.X - SliderBg.AbsolutePosition.X, 0, SliderBg.AbsoluteSize.X)
        local alpha = posX / SliderBg.AbsoluteSize.X
        local val = math.floor(minVal + (maxVal - minVal) * alpha)
        Fill.Size = UDim2.new(alpha, 0, 1, 0)
        Lbl.Text = labelText .. ": " .. tostring(val)
        callback(val)
    end

    SliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            UpdateInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    return ROW_H + 12
end

local function MakeSectionHeader(parent, text, yPos)
    local Sep = Instance.new("Frame")
    Sep.Size = UDim2.new(1,-PAD_X*2,0,1) ; Sep.Position = UDim2.new(0,PAD_X,0,yPos+6)
    Sep.BackgroundColor3 = C.SepLine ; Sep.BorderSizePixel = 0 ; Sep.ZIndex = 202 ; Sep.Parent = parent
    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1,-PAD_X*2,0,IsMobile and 16 or 18) ; Lbl.Position = UDim2.new(0,PAD_X,0,yPos+8)
    Lbl.BackgroundTransparency = 1 ; Lbl.Text = text ; Lbl.TextColor3 = C.Header
    Lbl.Font = FONT ; Lbl.TextSize = IsMobile and 10 or 11 ; Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.ZIndex = 202 ; Lbl.Parent = parent
    return (IsMobile and 16 or 18) + 10
end

