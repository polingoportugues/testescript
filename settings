-- ================================================================
-- CHECKBOX
-- ================================================================
local function MakeCheckbox(parent, key, labelText, yPos)
    local Row = Instance.new("Frame")
    Row.Name             = "Row_" .. key
    Row.Size             = UDim2.new(1, -PAD_X * 2, 0, ROW_H)
    Row.Position         = UDim2.new(0, PAD_X, 0, yPos)
    Row.BackgroundTransparency = 1
    Row.ZIndex           = 202
    Row.Parent           = parent

    local Box = Instance.new("Frame")
    Box.Name             = "Box"
    Box.Size             = UDim2.new(0, CHECK_S, 0, CHECK_S)
    Box.Position         = UDim2.new(0, 0, 0.5, -CHECK_S / 2)
    Box.BackgroundColor3 = C.CheckBg
    Box.BorderSizePixel  = 0
    Box.ZIndex           = 203
    Box.Parent           = Row
    Corner(Box, 3)
    Stroke(Box, C.CheckBorder, 1)

    local Tick = Instance.new("TextLabel")
    Tick.Size               = UDim2.new(1, 0, 1, 0)
    Tick.BackgroundTransparency = 1
    Tick.Text               = "✓"
    Tick.TextColor3         = Color3.fromRGB(255, 255, 255)
    Tick.Font               = FONT_BOLD
    Tick.TextSize           = IsMobile and 9 or 11
    Tick.TextXAlignment     = Enum.TextXAlignment.Center
    Tick.TextYAlignment     = Enum.TextYAlignment.Center
    Tick.TextTransparency   = 1
    Tick.ZIndex             = 204
    Tick.Parent             = Box

    local Lbl = Instance.new("TextLabel")
    Lbl.Size               = UDim2.new(1, -(CHECK_S + 8), 1, 0)
    Lbl.Position           = UDim2.new(0, CHECK_S + 8, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text               = labelText
    Lbl.TextColor3         = C.TextPrimary
    Lbl.Font               = FONT_REG
    Lbl.TextSize           = IsMobile and 11 or 13
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left
    Lbl.TextYAlignment     = Enum.TextYAlignment.Center
    Lbl.ZIndex             = 203
    Lbl.Parent             = Row

    local Btn = Instance.new("TextButton")
    Btn.Size               = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text               = ""
    Btn.AutoButtonColor    = false
    Btn.ZIndex             = 210
    Btn.Parent             = Row

    local function SetVisual(active)
        TweenService:Create(Box, TWEEN_F, {
            BackgroundColor3 = active and C.CheckActive or C.CheckBg,
        }):Play()
        TweenService:Create(Tick, TWEEN_F, {
            TextTransparency = active and 0 or 1,
        }):Play()
        TweenService:Create(Lbl, TWEEN_F, {
            TextColor3 = active and Color3.fromRGB(255,255,255) or C.TextPrimary,
        }):Play()
    end

    local function Toggle()
        State[key] = not State[key]
        SetVisual(State[key])
    end

    Btn.MouseButton1Click:Connect(Toggle)
    Btn.TouchTap:Connect(Toggle)
    Btn.MouseEnter:Connect(function()
        if not State[key] then
            TweenService:Create(Lbl, TWEEN_F, { TextColor3 = Color3.fromRGB(175, 165, 255) }):Play()
        end
    end)
    Btn.MouseLeave:Connect(function()
        if not State[key] then
            TweenService:Create(Lbl, TWEEN_F, { TextColor3 = C.TextPrimary }):Play()
        end
    end)

    SetVisual(State[key])
end

-- ================================================================
-- SECTION HEADER
-- ================================================================
local function MakeSectionHeader(parent, text, yPos)
    local Lbl = Instance.new("TextLabel")
    Lbl.Size               = UDim2.new(1, -PAD_X * 2, 0, IsMobile and 18 or 20)
    Lbl.Position           = UDim2.new(0, PAD_X, 0, yPos)
    Lbl.BackgroundTransparency = 1
    Lbl.Text               = text
    Lbl.TextColor3         = C.Header
    Lbl.Font               = FONT_BOLD
    Lbl.TextSize           = IsMobile and 9 or 10
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left
    Lbl.ZIndex             = 202
    Lbl.Parent             = parent

    local Sep = Instance.new("Frame")
    Sep.Size             = UDim2.new(1, -PAD_X * 2, 0, 1)
    Sep.Position         = UDim2.new(0, PAD_X, 0, yPos + (IsMobile and 18 or 20))
    Sep.BackgroundColor3 = C.SepLine
    Sep.BorderSizePixel  = 0
    Sep.ZIndex           = 202
    Sep.Parent           = parent

    return (IsMobile and 18 or 20) + 4
end

-- ================================================================
-- LAYOUT
-- ================================================================
local SECTIONS = {
    {
        label = nil,
        items = {
            { key = "AntiAFK",    label = "Anti AFK"    },
            { key = "AutoRejoin", label = "Auto Rejoin" },
        }
    },
    {
        label = "Interface",
        items = {
            { key = "HideGui", label = "Hide GUI" },
            { key = "NoHUD",   label = "No HUD"   },
        }
    },
    {
        label = "Performance",
        items = {
            { key = "UnlockFPS", label = "Unlock FPS" },
            { key = "DebugMode", label = "Debug Mode"  },
        }
    },
}

local ContentY = (IsMobile and 32 or 38) + 8
local cursor   = ContentY

for _, section in ipairs(SECTIONS) do
    if section.label then
        cursor = cursor + MakeSectionHeader(Win, section.label, cursor)
    end
    for _, item in ipairs(section.items) do
        MakeCheckbox(Win, item.key, item.label, cursor)
        cursor = cursor + ROW_H
    end
    cursor = cursor + PAD_Y
end

Win.Size = UDim2.new(0, WIN_W, 0, cursor + 6)

-- ================================================================
-- DRAG — PC
-- ================================================================
local dragging, dragStart, winStartPos = false, nil, nil

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging    = true
        dragStart   = input.Position
        winStartPos = Win.Position
    end
end)
Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Win.Position = UDim2.new(
            winStartPos.X.Scale, winStartPos.X.Offset + delta.X,
            winStartPos.Y.Scale, winStartPos.Y.Offset + delta.Y
        )
    end
end)

-- ================================================================
-- DRAG — MOBILE
-- ================================================================
local touchOrigin, touchWinPos = nil, nil

Header.TouchPan:Connect(function(touchPositions, _, _, state)
    if state == Enum.UserInputState.Begin then
        touchOrigin = touchPositions[1]
        touchWinPos = Win.Position
    elseif state == Enum.UserInputState.Change and touchWinPos then
        local delta = touchPositions[1] - touchOrigin
        Win.Position = UDim2.new(
            touchWinPos.X.Scale, touchWinPos.X.Offset + delta.X,
            touchWinPos.Y.Scale, touchWinPos.Y.Offset + delta.Y
        )
    elseif state == Enum.UserInputState.End then
        touchOrigin, touchWinPos = nil, nil
    end
end)
