    Bg          = Color3.fromRGB(10, 10, 18),
    Border      = Color3.fromRGB(40, 38, 65),
    Accent      = Color3.fromRGB(110, 85, 255),
    TextPrimary = Color3.fromRGB(210, 210, 230),
    CheckBg     = Color3.fromRGB(18, 17, 32),
