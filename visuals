-- // ANXIEE — Visuals Page (ImGui style)

local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui", 10)
if not PlayerGui then return end

if PlayerGui:FindFirstChild("Anxiee_Visuals") then
    PlayerGui:FindFirstChild("Anxiee_Visuals").Enabled = not PlayerGui:FindFirstChild("Anxiee_Visuals").Enabled
    return
end

local State = {
    ESP = false, Boxes = false, HealthBar = false, NameTag = false,
    Distance = false, Tracers = false, Chams = false, FullBright = false,
}

local C = {
    WinBg = Color3.fromRGB(28,28,28), TitleBg = Color3.fromRGB(41,74,122),
    TitleBgText = Color3.fromRGB(255,255,255), Border = Color3.fromRGB(90,90,90),
    FrameBg = Color3.fromRGB(41,41,41), FrameBgHov = Color3.fromRGB(55,55,55),
    CheckMark = Color3.fromRGB(79,144,220), Text = Color3.fromRGB(255,255,255),
    SepLine = Color3.fromRGB(70,70,70), Header = Color3.fromRGB(160,160,160),
}

local FONT      = Enum.Font.Code
local IsMobile  = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local WIN_W     = IsMobile and 220 or 260
local ROW_H     = IsMobile and 22 or 24
local CHECK_S   = IsMobile and 12 or 13
local PAD_X     = 8
local PAD_Y     = 6
local FONT_SIZE = IsMobile and 11 or 13
local TWEEN_F   = TweenInfo.new(0.06, Enum.EasingStyle.Linear)
local TitleH    = IsMobile and 22 or 26

local function Stroke(p, col, thick)
    local s = Instance.new("UIStroke")
    s.Color = col ; s.Thickness = thick
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border ; s.Parent = p
end

local Gui = Instance.new("ScreenGui")
Gui.Name = "Anxiee_Visuals" ; Gui.ResetOnSpawn = false
Gui.ZIndexBehavior = Enum.ZIndexBehavior.Global ; Gui.IgnoreGuiInset = true
Gui.DisplayOrder = 0x7FFFFFFE ; Gui.Parent = PlayerGui

local Win = Instance.new("Frame")
Win.Name = "Window" ; Win.Size = UDim2.new(0, WIN_W, 0, 100)
Win.Position = UDim2.new(0.5, -(WIN_W/2), 0.5, -120)
Win.BackgroundColor3 = C.WinBg ; Win.BorderSizePixel = 0
Win.ZIndex = 200 ; Win.Parent = Gui
Stroke(Win, C.Border, 1)

local TitleBar = Instance.new("Frame")
TitleBar.Name = "TitleBar" ; TitleBar.Size = UDim2.new(1,0,0,TitleH)
TitleBar.BackgroundColor3 = C.TitleBg ; TitleBar.BorderSizePixel = 0
TitleBar.ZIndex = 201 ; TitleBar.Parent = Win

local TitleLbl = Instance.new("TextLabel")
TitleLbl.Size = UDim2.new(1,-30,1,0) ; TitleLbl.Position = UDim2.new(0,PAD_X,0,0)
TitleLbl.BackgroundTransparency = 1 ; TitleLbl.Text = "Visuals"
TitleLbl.TextColor3 = C.TitleBgText ; TitleLbl.Font = FONT
TitleLbl.TextSize = FONT_SIZE ; TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
TitleLbl.ZIndex = 202 ; TitleLbl.Parent = TitleBar

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0,TitleH-2,0,TitleH-2)
CloseBtn.Position = UDim2.new(1,-(TitleH),0,1)
CloseBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
CloseBtn.Text = "x" ; CloseBtn.TextColor3 = Color3.fromRGB(255,255,255)
CloseBtn.Font = FONT ; CloseBtn.TextSize = FONT_SIZE
CloseBtn.AutoButtonColor = false ; CloseBtn.BorderSizePixel = 0
CloseBtn.ZIndex = 203 ; CloseBtn.Parent = TitleBar
Stroke(CloseBtn, Color3.fromRGB(150,40,40), 1)
CloseBtn.MouseButton1Click:Connect(function() Gui.Enabled = false end)
CloseBtn.TouchTap:Connect(function() Gui.Enabled = false end)

local TitleSep = Instance.new("Frame")
TitleSep.Size = UDim2.new(1,0,0,1) ; TitleSep.Position = UDim2.new(0,0,0,TitleH)
TitleSep.BackgroundColor3 = C.SepLine ; TitleSep.BorderSizePixel = 0
TitleSep.ZIndex = 201 ; TitleSep.Parent = Win

local function MakeCheckbox(parent, key, labelText, yPos)
    local Row = Instance.new("Frame")
    Row.Name = "Row_"..key ; Row.Size = UDim2.new(1,-PAD_X*2,0,ROW_H)
    Row.Position = UDim2.new(0,PAD_X,0,yPos) ; Row.BackgroundTransparency = 1
    Row.ZIndex = 202 ; Row.Parent = parent

    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(0,CHECK_S,0,CHECK_S) ; Box.Position = UDim2.new(0,0,0.5,-CHECK_S/2)
    Box.BackgroundColor3 = C.FrameBg ; Box.BorderSizePixel = 0
    Box.ZIndex = 203 ; Box.Parent = Row
    Stroke(Box, C.Border, 1)

    local Tick = Instance.new("TextLabel")
    Tick.Size = UDim2.new(1,0,1,0) ; Tick.BackgroundTransparency = 1
    Tick.Text = "✓" ; Tick.TextColor3 = Color3.fromRGB(255,255,255)
    Tick.Font = FONT ; Tick.TextSize = CHECK_S - 1
    Tick.TextXAlignment = Enum.TextXAlignment.Center ; Tick.TextYAlignment = Enum.TextYAlignment.Center
    Tick.TextTransparency = 1 ; Tick.ZIndex = 204 ; Tick.Parent = Box

    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1,-(CHECK_S+6),1,0) ; Lbl.Position = UDim2.new(0,CHECK_S+6,0,0)
    Lbl.BackgroundTransparency = 1 ; Lbl.Text = labelText
    Lbl.TextColor3 = C.Text ; Lbl.Font = FONT ; Lbl.TextSize = FONT_SIZE
    Lbl.TextXAlignment = Enum.TextXAlignment.Left ; Lbl.TextYAlignment = Enum.TextYAlignment.Center
    Lbl.ZIndex = 203 ; Lbl.Parent = Row

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,1,0) ; Btn.BackgroundTransparency = 1
    Btn.Text = "" ; Btn.AutoButtonColor = false ; Btn.ZIndex = 210 ; Btn.Parent = Row

    local function SetVisual(active)
        TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = active and C.CheckMark or C.FrameBg }):Play()
        TweenService:Create(Tick, TWEEN_F, { TextTransparency = active and 0 or 1 }):Play()
    end
    local function Toggle() State[key] = not State[key] ; SetVisual(State[key]) end
    Btn.MouseButton1Click:Connect(Toggle) ; Btn.TouchTap:Connect(Toggle)
    Btn.MouseEnter:Connect(function() TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = State[key] and C.CheckMark or C.FrameBgHov }):Play() end)
    Btn.MouseLeave:Connect(function() TweenService:Create(Box, TWEEN_F, { BackgroundColor3 = State[key] and C.CheckMark or C.FrameBg }):Play() end)
    SetVisual(State[key])
end

local function MakeSectionHeader(parent, text, yPos)
    local Sep = Instance.new("Frame")
    Sep.Size = UDim2.new(1,-PAD_X*2,0,1) ; Sep.Position = UDim2.new(0,PAD_X,0,yPos+6)
    Sep.BackgroundColor3 = C.SepLine ; Sep.BorderSizePixel = 0 ; Sep.ZIndex = 202 ; Sep.Parent = parent
    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1,-PAD_X*2,0,IsMobile and 16 or 18) ; Lbl.Position = UDim2.new(0,PAD_X,0,yPos+8)
    Lbl.BackgroundTransparency = 1 ; Lbl.Text = text ; Lbl.TextColor3 = C.Header
    Lbl.Font = FONT ; Lbl.TextSize = IsMobile and 10 or 11 ; Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.ZIndex = 202 ; Lbl.Parent = parent
    return (IsMobile and 16 or 18) + 10
end

local SECTIONS = {
    { label = nil, items = {
        { key="ESP", label="ESP" }, { key="Boxes", label="Boxes" },
        { key="HealthBar", label="Health Bar" }, { key="NameTag", label="Name Tag" },
    }},
    { label = "Extra", items = {
        { key="Distance", label="Distance" }, { key="Tracers", label="Tracers" },
    }},
    { label = "World", items = {
        { key="Chams", label="Chams" }, { key="FullBright", label="Full Bright" },
    }},
}

local cursor = TitleH + 4
for _, section in ipairs(SECTIONS) do
    if section.label then cursor = cursor + MakeSectionHeader(Win, section.label, cursor) end
    for _, item in ipairs(section.items) do MakeCheckbox(Win, item.key, item.label, cursor) ; cursor += ROW_H end
    cursor += PAD_Y
end
Win.Size = UDim2.new(0, WIN_W, 0, cursor + 6)

local dragging, dragStart, winStartPos = false, nil, nil
TitleBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=true;dragStart=i.Position;winStartPos=Win.Position end end)
TitleBar.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dragStart
        Win.Position = UDim2.new(winStartPos.X.Scale,winStartPos.X.Offset+d.X,winStartPos.Y.Scale,winStartPos.Y.Offset+d.Y)
    end
end)
local touchOrigin, touchWinPos = nil, nil
TitleBar.TouchPan:Connect(function(tp,_,_,state)
    if state==Enum.UserInputState.Begin then touchOrigin=tp[1];touchWinPos=Win.Position
    elseif state==Enum.UserInputState.Change and touchWinPos then
        local d=tp[1]-touchOrigin
        Win.Position=UDim2.new(touchWinPos.X.Scale,touchWinPos.X.Offset+d.X,touchWinPos.Y.Scale,touchWinPos.Y.Offset+d.Y)
    elseif state==Enum.UserInputState.End then touchOrigin,touchWinPos=nil,nil end
end)
