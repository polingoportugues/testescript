-- ─── BOX SYSTEM ───────────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local BOX_COLOR = Color3.fromRGB(255, 255, 255)

local function newBar()
    local f = Instance.new("Frame")
    f.BackgroundColor3       = BOX_COLOR
    f.BackgroundTransparency = 0
    f.BorderSizePixel        = 0
    f.Visible                = false
    f.Parent                 = BoxRoot
    return f
end

local function makeBoxESP()
    return { top = newBar(), bot = newBar(), lft = newBar(), rgt = newBar() }
end

local function destroyBoxESP(e)
    e.top:Destroy()
    e.bot:Destroy()
    e.lft:Destroy()
    e.rgt:Destroy()
end

local function hideBoxESP(e)
    e.top.Visible = false
    e.bot.Visible = false
    e.lft.Visible = false
    e.rgt.Visible = false
end

local function drawBox(e, x0, y0, x1, y1)
    local w, h, T = x1 - x0, y1 - y0, BOX_THICKNESS
    e.top.Position = UDim2.fromOffset(x0,     y0);     e.top.Size = UDim2.fromOffset(w, T); e.top.Visible = true
    e.bot.Position = UDim2.fromOffset(x0,     y1 - T); e.bot.Size = UDim2.fromOffset(w, T); e.bot.Visible = true
    e.lft.Position = UDim2.fromOffset(x0,     y0);     e.lft.Size = UDim2.fromOffset(T, h); e.lft.Visible = true
    e.rgt.Position = UDim2.fromOffset(x1 - T, y0);     e.rgt.Size = UDim2.fromOffset(T, h); e.rgt.Visible = true
end

