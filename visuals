-- ─── CHAMS SYSTEM ─────────────────────────────────────────────────────────────
local function removeChamsFromChar(character)
    if not character then return end
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Highlight") and v.Name == "ChamsHighlight" then
            v:Destroy()
        end
    end
end

local function applyChamsToChar(character)
    if not character then return end
    removeChamsFromChar(character)

    local highlight = Instance.new("Highlight")
    highlight.Name = "ChamsHighlight"
    highlight.FillColor = CHAM_COLOR
    highlight.FillTransparency = FILL_TRANSPARENCY
    highlight.OutlineColor = OUTLINE_COLOR
    highlight.OutlineTransparency = OUTLINE_TRANSPARENCY
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
end

-- ─── Pool unificado ───────────────────────────────────────────────────────────
local espPool = {}

local function addPlayer(p)
    if p == LocalPlayer or espPool[p] then return end
    
    local connections = {}
    connections[#connections + 1] = p.CharacterAdded:Connect(function(char)
        if State.Chams then
            task.defer(function()
                applyChamsToChar(char)
            end)
        end
        if State.Skeleton then
            task.defer(function()
                applySkeletonToChar(char)
            end)
        end
    end)

    espPool[p] = {
        label       = makeNameLabel(),
        distLabel   = makeDistLabel(),
        boxESP      = makeBoxESP(),
        tracer      = makeTracer(),
        connections = connections
    }

    if p.Character then
        if State.Chams then
            task.defer(function() applyChamsToChar(p.Character) end)
        end
        if State.Skeleton then
            task.defer(function() applySkeletonToChar(p.Character) end)
        end
    end
end

local function removePlayer(p)
    local e = espPool[p]
    if not e then return end

    for _, conn in ipairs(e.connections or {}) do
        conn:Disconnect()
    end

    if p.Character then
        removeChamsFromChar(p.Character)
        removeSkeletonFromChar(p.Character)
    end

    e.label:Destroy()
    e.distLabel:Destroy()
    e.tracer:Destroy()
    destroyBoxESP(e.boxESP)
    espPool[p] = nil
end

for _, p in ipairs(Players:GetPlayers()) do addPlayer(p) end
Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)

-- ─── RenderStepped unificado ──────────────────────────────────────────────────
RunService.RenderStepped:Connect(function()
    for player, entry in pairs(espPool) do
        if not player or not player.Parent then
            removePlayer(player)
            continue
        end

        local char = player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local alive = hum and hum.Health > 0

        if not char or not alive or not root then
            entry.label.Visible     = false
            entry.distLabel.Visible = false
            entry.tracer.Visible    = false
            hideBoxESP(entry.boxESP)
            continue
        end

        local x0, y0, x1, y1 = getBounds(char)

        -- ── Name Tag ────────────────────────────────────────────────────────
        if State.NameTag and x0 then
            local w = x1 - x0
            entry.label.Text     = player.DisplayName
            entry.label.Position = UDim2.fromOffset(x0 + w * 0.5, y0 - 3)
            entry.label.Size     = UDim2.fromOffset(w, 14)
            entry.label.Visible  = true
        else
            entry.label.Visible = false
        end

        -- ── Distance ────────────────────────────────────────────────────────
        if State.Distance and x0 then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            if myRoot then
                local w = x1 - x0
                local d = math.floor((root.Position - myRoot.Position).Magnitude)
                entry.distLabel.Text     = d .. " studs"
                entry.distLabel.Position = UDim2.fromOffset(x0 + w * 0.5, y1 + 1)
                entry.distLabel.Size     = UDim2.fromOffset(w, 12)
                entry.distLabel.Visible  = true
            else
                entry.distLabel.Visible = false
            end
        else
            entry.distLabel.Visible = false
        end

        -- ── Tracers (Line Down -> Pés) ─────────────────────────────────────────
        if State.Tracers then
            local feetOffset = Vector3.new(0, (root.Size.Y / 2) + (hum.HipHeight or 0), 0)
            local feetPosition = root.Position - feetOffset
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(feetPosition)
            if onScreen then
                drawTracer(entry.tracer, Vector2.new(screenPos.X, screenPos.Y))
            else
                entry.tracer.Visible = false
            end
        else
            entry.tracer.Visible = false
        end

        -- ── Boxes ────────────────────────────────────────────────────────────
        if State.Boxes and x0 then
            drawBox(entry.boxESP, x0, y0, x1, y1)
        else
            hideBoxESP(entry.boxESP)
        end
    end
end)

