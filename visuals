-- ─── SKELETON SYSTEM ──────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local function removeSkeletonFromChar(character)
    if not character then return end
    local folder = character:FindFirstChild("3DSkeletonESP")
    if folder then
        folder:Destroy()
    end
end

local function applySkeletonToChar(character)
    if not character then return end
    removeSkeletonFromChar(character)

    local folder = Instance.new("Folder")
    folder.Name = "3DSkeletonESP"
    folder.Parent = character

    local adornments = {}

    for i = 1, #SKELETON_CONNECTIONS do
        local wireframe = Instance.new("WireframeHandleAdornment")
        wireframe.Color3 = SKELETON_COLOR
        wireframe.AlwaysOnTop = true
        wireframe.ZIndex = 10
        wireframe.Adornee = workspace
        wireframe.Parent = folder
        table.insert(adornments, wireframe)
    end

    local conn: RBXScriptConnection? = nil
    conn = RunService.RenderStepped:Connect(function()
        if not character or not character.Parent or not character:FindFirstChild("HumanoidRootPart") or not folder.Parent or not State.Skeleton then
            if not State.Skeleton then
                folder:Destroy()
            end
            if conn then conn:Disconnect() end
            return
        end

        for i, pair in ipairs(SKELETON_CONNECTIONS) do
            local part1 = character:FindFirstChild(pair[1]) :: BasePart?
            local part2 = character:FindFirstChild(pair[2]) :: BasePart?
            local wireframe = adornments[i]

            if part1 and part2 and wireframe then
                wireframe:Clear()
                wireframe:AddLine(part1.Position, part2.Position)
                wireframe.Visible = true
            elseif wireframe then
                wireframe.Visible = false
            end
        end
    end)
end

