-- ─── getBounds (compartilhado) ────────────────────────────────────────────────
local function getBounds(character)
    local s, cf, sz = pcall(function() return character:GetBoundingBox() end)
    if not s then return nil, nil, nil, nil end
    local h = sz / 2
    local corners = {
        cf * Vector3.new(-h.X,  h.Y, -h.Z),
        cf * Vector3.new( h.X,  h.Y, -h.Z),
        cf * Vector3.new(-h.X, -h.Y, -h.Z),
        cf * Vector3.new( h.X, -h.Y, -h.Z),
        cf * Vector3.new(-h.X,  h.Y,  h.Z),
        cf * Vector3.new( h.X,  h.Y,  h.Z),
        cf * Vector3.new(-h.X, -h.Y,  h.Z),
        cf * Vector3.new( h.X, -h.Y,  h.Z),
    }
    local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
    local visible = 0
    for _, v in ipairs(corners) do
        local sp = Camera:WorldToViewportPoint(v)
        if sp.Z > 0 then
            visible += 1
            if sp.X < x0 then x0 = sp.X end
            if sp.Y < y0 then y0 = sp.Y end
            if sp.X > x1 then x1 = sp.X end
            if sp.Y > y1 then y1 = sp.Y end
        end
    end
    if visible == 0 or x1 <= x0 or y1 <= y0 then
        return nil, nil, nil, nil
    end
    return x0, y0, x1, y1
end

