-- ─── CHECKBOX ─────────────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local function MakeCheckbox(parent, key, labelText, yPos, onToggle)
    local Row = Instance.new("Frame")
    Row.Name                   = "Row_"..key
    Row.Size                   = UDim2.new(1,-PAD_X*2,0,ROW_H)
    Row.Position               = UDim2.new(0,PAD_X,0,yPos)
    Row.BackgroundTransparency = 1
    Row.ZIndex                 = 202
    Row.Parent                 = parent

    local Box = Instance.new("Frame")
    Box.Size             = UDim2.new(0,CHECK_S,0,CHECK_S)
    Box.Position         = UDim2.new(0,0,0.5,-CHECK_S/2)
    Box.BackgroundColor3 = C.FrameBg
    Box.BorderSizePixel  = 0
    Box.ZIndex           = 203
    Box.Parent           = Row
    Stroke(Box, C.Border, 1)

    local Tick = Instance.new("TextLabel")
    Tick.Size                   = UDim2.new(1,0,1,0)
    Tick.BackgroundTransparency = 1
    Tick.Text                   = "✓"
    Tick.TextColor3             = Color3.fromRGB(255,255,255)
    Tick.Font                   = FONT
    Tick.TextSize               = CHECK_S - 1
    Tick.TextXAlignment         = Enum.TextXAlignment.Center
    Tick.TextYAlignment         = Enum.TextYAlignment.Center
    Tick.TextTransparency       = 1
    Tick.ZIndex                 = 204
    Tick.Parent                 = Box

    local Lbl = Instance.new("TextLabel")
    Lbl.Size                   = UDim2.new(1,-(CHECK_S+6),1,0)
    Lbl.Position               = UDim2.new(0,CHECK_S+6,0,0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text                   = labelText
    Lbl.TextColor3             = C.Text
    Lbl.Font                   = FONT
    Lbl.TextSize               = FONT_SIZE
    Lbl.TextXAlignment         = Enum.TextXAlignment.Left
    Lbl.TextYAlignment         = Enum.TextYAlignment.Center
    Lbl.ZIndex                 = 203
    Lbl.Parent                 = Row

    local Btn = Instance.new("TextButton")
    Btn.Size                   = UDim2.new(1,0,1,0)
    Btn.BackgroundTransparency = 1
    Btn.Text                   = ""
    Btn.AutoButtonColor        = false
    Btn.ZIndex                 = 220
    Btn.Parent                 = Row

    local function SetVisual(active)
        TweenService:Create(Box,  TWEEN_F, { BackgroundColor3 = active and C.CheckMark or C.FrameBg }):Play()
        TweenService:Create(Tick, TWEEN_F, { TextTransparency = active and 0 or 1 }):Play()
    end

    local function Toggle()
        State[key] = not State[key]
        SetVisual(State[key])
        if onToggle then
            onToggle(State[key])
        end
    end

    Btn.Activated:Connect(Toggle)

    Btn.MouseEnter:Connect(function()
        TweenService:Create(Box, TWEEN_F, {
            BackgroundColor3 = State[key] and C.CheckMark or C.FrameBgHov
        }):Play()
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Box, TWEEN_F, {
            BackgroundColor3 = State[key] and C.CheckMark or C.FrameBg
        }):Play()
    end)

    SetVisual(State[key])
end

