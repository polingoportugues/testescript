-- ─── TRACERS SYSTEM (LINE DOWN TO FEET) ──────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local function makeTracer()
    local f = Instance.new("Frame")
    f.Name                   = "TracerLine"
    f.AnchorPoint            = Vector2.new(0.5, 0.5)
    f.BackgroundColor3       = TRACER_COLOR
    f.BorderSizePixel        = 0
    f.Visible                = false
    f.ZIndex                 = 5
    f.Parent                 = ESPRoot
    return f
end

local function drawTracer(frame, targetPos)
    local viewportSize = Camera.ViewportSize
    local origin = Vector2.new(viewportSize.X / 2, viewportSize.Y) -- Centro Inferior
    
    local dx = targetPos.X - origin.X
    local dy = targetPos.Y - origin.Y
    local distance = math.sqrt(dx * dx + dy * dy)
    local angle = math.deg(math.atan2(dy, dx))

    frame.Size     = UDim2.fromOffset(distance, TRACER_THICKNESS)
    frame.Position = UDim2.fromOffset((origin.X + targetPos.X) / 2, (origin.Y + targetPos.Y) / 2)
    frame.Rotation = angle
    frame.Visible  = true
end

