            { key = "Skeleton", label = "Skeleton", cb = onSkeletonToggle },
        }
    },
}

local cursor = TitleH + 4
for _, section in ipairs(SECTIONS) do
    if section.label then
        cursor = cursor + MakeSectionHeader(Win, section.label, cursor)
    end
    for _, item in ipairs(section.items) do
        MakeCheckbox(Win, item.key, item.label, cursor, item.cb)
        cursor += ROW_H
    end
    cursor += PAD_Y
end
Win.Size = UDim2.new(0, WIN_W, 0, cursor + 6)

-- ═══════════════════════════════════════════════════════════════════════════════
-- ─── DRAG — Mouse ─────────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local dragging, dragStart, winStartPos = false, nil, nil

TitleBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging     = true
        dragStart    = i.Position
        winStartPos  = Win.Position
    end
end)
TitleBar.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dragStart
        Win.Position = UDim2.new(
            winStartPos.X.Scale, winStartPos.X.Offset + d.X,
            winStartPos.Y.Scale, winStartPos.Y.Offset + d.Y
        )
    end
end)

-- ─── DRAG — Touch ─────────────────────────────────────────────────────────────
local touchOrigin, touchWinPos = nil, nil

TitleBar.TouchPan:Connect(function(tp, _, _, state)
    if state == Enum.UserInputState.Begin then
        touchOrigin = tp[1]
        touchWinPos = Win.Position
    elseif state == Enum.UserInputState.Change and touchWinPos then
        local d = tp[1] - touchOrigin
        Win.Position = UDim2.new(
            touchWinPos.X.Scale, touchWinPos.X.Offset + d.X,
            touchWinPos.Y.Scale, touchWinPos.Y.Offset + d.Y
        )
    elseif state == Enum.UserInputState.End then
        touchOrigin, touchWinPos = nil, nil
    end
end)
