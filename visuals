local function onBoxesToggle(active)
    if not active then
        for _, entry in pairs(espPool) do
            hideBoxESP(entry.boxESP)
        end
    end
end

local function onDistanceToggle(active)
    if not active then
        for _, entry in pairs(espPool) do
            entry.distLabel.Visible = false
        end
    end
end

local function onTracersToggle(active)
    if not active then
        for _, entry in pairs(espPool) do
            entry.tracer.Visible = false
        end
    end
end

local function onChamsToggle(active)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if active then
                applyChamsToChar(p.Character)
            else
                removeChamsFromChar(p.Character)
            end
        end
    end
end

local function onSkeletonToggle(active)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if active then
                applySkeletonToChar(p.Character)
            else
                removeSkeletonFromChar(p.Character)
            end
        end
    end
end

